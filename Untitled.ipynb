   "source": [
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "import torch\n",
    "import scipy.sparse as sp\n",
    "\n",
    "from torch_geometric.data import Data\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from GraphRicciCurvature.OllivierRicci import OllivierRicci\n",
    "from utils import *\n",
    "\n",
    "\n",
    "# -------------------------\n",
    "# Dataset wrapper\n",
    "# -------------------------\n",
    "class Data_class(Dataset):\n",
    "    def __init__(self, triple, curvature):\n",
    "        self.entity1 = triple[:, 0]\n",
    "        self.entity2 = triple[:, 1]\n",
    "        self.label = triple[:, 2]\n",
    "        self.curvature = curvature\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.label)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        return (\n",
    "            self.label[index],\n",
    "            (self.entity1[index], self.entity2[index]),\n",
    "            self.curvature[index]\n",
    "        )\n",
    "\n",
    "\n",
    "# -------------------------\n",
    "# Curvature computation\n",
    "# -------------------------\n",
    "def get_curvature(unique_entity, positive):\n",
    "\n",
    "    G = nx.Graph()\n",
    "    G.add_edges_from(positive)\n",
    "    \n",
    "    # --- ADD STRUCTURE ONLY FROM TRAIN GRAPH ---\n",
    "   # for u in list(G.nodes()):\n",
    "    #    for v in nx.single_source_shortest_path_length(G, u, cutoff=2):\n",
    "     #       if u != v:\n",
    "      #          G.add_edge(u, v)\n",
    "\n",
    "    for n in G.nodes:\n",
    "        G.add_edge(n, n)\n",
    "\n",
    "    orc = OllivierRicci(G, alpha=0.5, verbose=\"INFO\")\n",
    "    orc.compute_ricci_curvature()\n",
    "\n",
    "    adj = sp.coo_matrix(\n",
    "        (np.ones(len(positive)), (positive[:, 0], positive[:, 1])),\n",
    "        shape=(unique_entity, unique_entity),\n",
    "        dtype=np.float32\n",
    "    )\n",
    "\n",
    "    adj = adj + adj.T.multiply(adj.T > adj) - adj.multiply(adj.T > adj)\n",
    "    edges = adj.nonzero()\n",
    "\n",
    "    edge_index = torch.tensor(\n",
    "        np.vstack((edges[0], edges[1])),\n",
    "        dtype=torch.long\n",
    "    )\n",
    "\n",
    "    edge_curv = []\n",
    "    edge_to_curv = {}  \n",
    "\n",
    "    for i in range(edge_index.shape[1]):\n",
    "        u = edge_index[0, i].item()\n",
    "        v = edge_index[1, i].item()\n",
    "\n",
    "        if u == v:\n",
    "            c = 0.0\n",
    "        else:\n",
    "            c = orc.G[u][v][\"ricciCurvature\"]\n",
    "\n",
    "        edge_curv.append(c)\n",
    "        edge_to_curv[(u, v)] = c\n",
    "        \n",
    "    edge_curv = torch.tensor(edge_curv, dtype=torch.float)\n",
    "\n",
    "\n",
    "    edge_curv = (edge_curv - edge_curv.mean()) / (edge_curv.std() + 1e-8)\n",
    "\n",
    "    return edge_index, edge_curv, edge_to_curv\n",
    "\n",
    "\n",
    "# -------------------------\n",
    "# Main loader\n",
    "# -------------------------\n",
    "def load_data(args, val_ratio=0.1, test_ratio=0.2):\n",
    "\n",
    "    print(f\"Loading {args.in_file} seed {args.seed} dataset...\")\n",
    "\n",
    "    positive = np.loadtxt(args.in_file, dtype=np.int64)\n",
    "\n",
    "    G_all = nx.Graph()\n",
    "    G_all.add_edges_from(positive)\n",
    "\n",
    "    unique_entity = len(G_all.nodes)\n",
    "\n",
    "    np.random.seed(args.seed)\n",
    "    np.random.shuffle(positive)\n",
    "\n",
    "    link_size = int(positive.shape[0] * args.network_ratio)\n",
    "    positive = positive[:link_size]\n",
    "    print(\"Total possible positive edges:\", len(positive))\n",
    "\n",
    "    val_size = int(val_ratio * positive.shape[0])\n",
    "    test_size = int(test_ratio * positive.shape[0])\n",
    "\n",
    "    train_positive = positive[:-(val_size + test_size)]\n",
    "    val_positive = positive[-(val_size + test_size):-test_size]\n",
    "    test_positive = positive[-test_size:]\n",
    "\n",
    "    negative_all = list(nx.non_edges(G_all))\n",
    "    np.random.shuffle(negative_all)\n",
    "    print(\"Total possible negative edges:\", len(negative_all))\n",
    "\n",
    "    negative = np.asarray(negative_all[:positive.shape[0]])\n",
    "\n",
    "    print(f\"positive: {positive.shape[0]}, negative: {negative.shape[0]}\")\n",
    "\n",
    "    positive = np.concatenate([positive, np.ones((positive.shape[0], 1))], axis=1)\n",
    "    negative = np.concatenate([negative, np.zeros((negative.shape[0], 1))], axis=1)\n",
    "\n",
    "    train_data = np.vstack((positive[:-(val_size + test_size)],\n",
    "                            negative[:-(val_size + test_size)]))\n",
    "\n",
    "    val_data = np.vstack((positive[-(val_size + test_size):-test_size],\n",
    "                          negative[-(val_size + test_size):-test_size]))\n",
    "\n",
    "    test_data = np.vstack((positive[-test_size:],\n",
    "                           negative[-test_size:]))\n",
    "\n",
    "    params = {\n",
    "        'batch_size': args.batch,\n",
    "        'shuffle': True,\n",
    "        'num_workers': args.workers,\n",
    "        'drop_last': True\n",
    "    }\n",
    "\n",
    "    #train_loader = DataLoader(Data_class(train_data, torch.zeros(len(train_data))), **params)\n",
    "    #val_loader = DataLoader(Data_class(val_data, torch.zeros(len(val_data))), **params)\n",
    "    #test_loader = DataLoader(Data_class(test_data, torch.zeros(len(test_data))), **params)\n",
    "    # 1. Compute curvature\n",
    "    _, _, edge_to_curv = get_curvature(unique_entity, train_positive)\n",
    "\n",
    "    # 2. Map curvature to your train/val/test data\n",
    "    def map_curv(data_triple, edge_map):\n",
    "        curvs = [edge_map.get(tuple(sorted((int(u), int(v)))), 0.0) for u, v in data_triple[:, :2]]\n",
    "        return torch.tensor(curvs, dtype=torch.float)\n",
    "\n",
    "    train_loader = DataLoader(Data_class(train_data, map_curv(train_data, edge_to_curv)), **params)\n",
    "    val_loader = DataLoader(Data_class(val_data, map_curv(val_data, edge_to_curv)), **params)\n",
    "    test_loader = DataLoader(Data_class(test_data, map_curv(test_data, edge_to_curv)), **params)\n",
    "\n",
    "    # ---------------- features ----------------\n",
    "    print(\"Extracting features...\")\n",
    "\n",
    "    if args.feature_type == \"one_hot\":\n",
    "        features = np.eye(unique_entity)\n",
    "\n",
    "    elif args.feature_type == \"uniform\":\n",
    "        features = np.random.uniform(0, 1, (unique_entity, args.dimensions))\n",
    "\n",
    "    elif args.feature_type == \"normal\":\n",
    "        features = np.random.normal(0, 1, (unique_entity, args.dimensions))\n",
    "\n",
    "    elif args.feature_type == \"position\":\n",
    "        adj = sp.coo_matrix(\n",
    "            (np.ones(train_positive.shape[0]),\n",
    "             (train_positive[:, 0], train_positive[:, 1])),\n",
    "            shape=(unique_entity, unique_entity),\n",
    "            dtype=np.float32\n",
    "        )\n",
    "        adj = adj + adj.T.multiply(adj.T > adj) - adj.multiply(adj.T > adj)\n",
    "        features = adj.todense()\n",
    "\n",
    "    features = normalize(features)\n",
    "    args.dimensions = features.shape[1]\n",
    "\n",
    "    x_o = torch.tensor(features, dtype=torch.float)\n",
    "\n",
    "    adj = sp.coo_matrix(\n",
    "        (np.ones(positive.shape[0]),\n",
    "         (positive[:, 0], positive[:, 1])),\n",
    "        shape=(unique_entity, unique_entity),\n",
    "        dtype=np.float32\n",
    "    )\n",
    "\n",
    "    adj = adj + adj.T.multiply(adj.T > adj) - adj.multiply(adj.T > adj)\n",
    "\n",
    "    edges = adj.nonzero()\n",
    "\n",
    "    edge_index_o = torch.tensor(\n",
    "        np.vstack((edges[0], edges[1])),\n",
    "        dtype=torch.long\n",
    "    )\n",
    "\n",
    "    data_o = Data(\n",
    "        x=x_o,\n",
    "        edge_index=edge_index_o\n",
    "    )\n",
    "\n",
    "    print(\"Loading finished!\")\n",
    "\n",
    "    return data_o, train_loader, val_loader, test_loader"
   ]
  },
